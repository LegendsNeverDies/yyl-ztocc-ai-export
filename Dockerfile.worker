FROM node:20-slim

WORKDIR /app

# 安装依赖
COPY package.json package-lock.json ./
RUN npm ci --omit=dev || npm install

# 安装 worker 依赖
COPY worker/package.json worker/package.json
RUN cd worker && npm install

# 复制源码
COPY . .

# 环境变量
ENV PORT=8080
ENV NODE_ENV=production

# 暴露端口
EXPOSE 8080

# 启动 worker
CMD ["npx", "tsx", "worker/src/server.ts"]
