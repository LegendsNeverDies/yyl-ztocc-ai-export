{
  "name": "压测标准规则",
  "description": "适用于 10000-orders.xlsx 的 standard 解析规则",
  "fileType": "excel",
  "parseMode": "standard",
  "excel": {
    "headerRows": 1,
    "footerRows": 0,
    "dataStartRow": 1
  },
  "fieldMappings": [
    {
      "fromCol": 0,
      "toField": "externalCode"
    },
    {
      "fromCol": 1,
      "toField": "storeName"
    },
    {
      "fromCol": 2,
      "toField": "receiverName"
    },
    {
      "fromCol": 3,
      "toField": "receiverPhone"
    },
    {
      "fromCol": 4,
      "toField": "receiverAddress"
    },
    {
      "fromCol": 5,
      "toField": "skuCode"
    },
    {
      "fromCol": 6,
      "toField": "skuName"
    },
    {
      "fromCol": 7,
      "toField": "skuQuantity"
    },
    {
      "fromCol": 8,
      "toField": "skuSpec"
    }
  ],
  "defaults": {}
}